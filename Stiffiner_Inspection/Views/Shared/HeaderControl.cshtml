@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var controller = ViewContext.RouteData.Values["controller"].ToString();
    var action = ViewContext.RouteData.Values["action"].ToString();
    var currentModel = Global.currentSelectedModel;
}

<div id="header-control" class="@(action == "History" ? "mt-3" : "") d-flex justify-content-between">
    <div id="time" class="d-flex align-items-center">
        <div id="date">
            Thursday, Jan 18, 2024
        </div>
        <div id="current-time">
            13:33:53
        </div>
    </div>

    @if (action == "Index" && controller == "Home")
    {
        <div id="action" class="d-flex align-items-center">
            <div class="d-flex align-items-center" style="margin-right: 3em">
                <label for="select-model d-inline-block mr-5" style="margin-right: 10px;font-weight: bold">Model</label>
                @if (currentModel == 1)
                {
                    <select id="select-model" class="form-select">
                        <option value="1" selected="selected">Stiffener Inspection</option>
                        <option value="2">Stiffener Filler</option>
                    </select>
                }
                else
                {
                    <select id="select-model" class="form-select">
                        <option value="1">Stiffener Inspection</option>
                        <option value="2" selected="selected">Stiffener Filler</option>
                    </select>
                }
            </div>
            <button type="button" class="btn btn-danger btn-export-excel" data-toggle="modal" data-target="#exampleModal1">
                Clear Data
            </button>

            <div class="modal fade" id="exampleModal1" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title fw-bold" style="font-size: 18px;" id="exampleModalLabel">Do you want to clear data?</h4>
                            <button type="button" class="btn close" data-dismiss="modal" aria-label="Close">
                                X
                            </button>
                        </div>

                        <form asp-action="ClearData" asp-controller="Home" method="post">
                            <div class="modal-footer" style="border-top: none">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger btn-apply-target">Apply</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <button class="ml-4 btn btn-primary" style="margin-left: 3em" onclick="location.reload();">Refresh Data</button>
    }
</div>